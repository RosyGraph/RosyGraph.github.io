---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Chris Stevenson">
  <main>
    <section class="hero" id="top">
      <h1>Chris Stevenson</h1>

      <p>
        I build AI-enabled backend systems for extracting, validating, and
        serving structured data from messy real-world inputs.
      </p>

      <nav aria-label="Page navigation">
        <a href="#work">work</a>
        <a
          href="/resume/chris-stevenson-resume.pdf"
          target="_blank"
          rel="noopener noreferrer">resume</a
        >
        <a href="https://github.com/RosyGraph">github</a>
        <a href="https://www.linkedin.com/in/chris-stevenson-b7028831/"
          >linkedin</a
        >
      </nav>
    </section>

    <section id="work">
      <h2>work</h2>

      <article>
        <h3>Velvet AI</h3>
        <p class="meta">2021–2026</p>
        <p class="links">
          <a href="https://velvet.vc/">site</a>
        </p>
        <p>
          Software for venture-capital workflows. Built backend systems for
          extracting structured data from heterogeneous business documents using
          retrieval, validation, and distributed processing.
        </p>
      </article>

      <article>
        <h3>Cytometry dashboard</h3>

        <p class="links">
          <a href="https://cytometry-dashboard.rosygraph.com">site</a>
          <span aria-hidden="true">/</span>
          <a href="https://github.com/RosyGraph/cytometry-dashboard/">github</a>
        </p>
        <p>
          A reproducible cytometry analysis pipeline and Streamlit dashboard for
          exploring immune-cell treatment response data. Loads raw sample counts
          into a normalized SQLite database, computes relative population
          frequencies, and generates reports, plots, and interactive views for
          analysis
        </p>
      </article>

      <article>
        <h3>Chrimbus — Raspberry Pi LED controller</h3>
        <p class="links">
          <a href="https://github.com/RosyGraph/chrimbus/">github</a>
        </p>
        <p>
          A Raspberry Pi-powered Christmas light grid with programmable LED
          animations. Includes a visualizer, challenge files, and a pattern
          system so other people can author animations for me to run in my
          window.
        </p>
      </article>
    </section>

    <hr />

    <section id="contact">
      <h2>contact</h2>
      <p>
        <a href="mailto:hello@rosygraph.com">email</a>
        ·
        <a href="https://github.com/RosyGraph">github</a>
        ·
        <a href="https://www.linkedin.com/in/chris-stevenson-b7028831"
          >linkedin</a
        >
      </p>
    </section>
  </main>
</Layout>
